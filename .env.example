# --- START OF FILE: .env.example ---
# Configuration de l'environnement pour le Vaisseau Guardian V9

# URL du serveur de l'Oracle (LLM)
LLAMA_SERVER_URL="http://localhost:8080/completion"

# Chemin vers la librairie native compilée (le Corps Natif)
# Utiliser des slashes (/) même sous Windows pour la compatibilité
NATIVE_LIB_PATH="csrc/build/Release/sentire_core.dll"

# Niveau de journalisation (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Seuil de déclenchement de la surveillance (en pourcentage)
CPU_CRISIS_THRESHOLD=90.0
MEMORY_CRISIS_THRESHOLD=90.0

# Cooldown en secondes entre les actions pour éviter le spam
ACTION_COOLDOWN_SECONDS=60

# --- Configuration du Chroniqueur Souverain ---
GCP_PROJECT_ID="abiding-sunset-468821-g9"
GCP_PUBSUB_TOPIC="telemetry-ingest"
GCP_CREDENTIALS_PATH="C:/sentire-guardian-v9/predator/gcp-credentials.json"
# --- END OF FILE: .env.example ---
