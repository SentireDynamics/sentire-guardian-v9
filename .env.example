# === Oracle LLM (granite3-moe:3b-instruct-q4_K_M) ===
LLAMA_SERVER_URL="http://localhost:11434/api/generate"
ORACLE_MODEL_NAME="granite3-moe:3b-instruct-q4_K_M"

# === Corps Natif (sentire_core.dll) ===
NATIVE_LIB_PATH=csrc/build/Release/sentire_core.dll

# === Paramètres du Vaisseau ===
LOG_LEVEL=INFO
ACTION_COOLDOWN_SECONDS=60

