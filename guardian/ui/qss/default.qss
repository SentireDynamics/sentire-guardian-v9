/* guardian/ui/qss/default.qss */
/*
Artefact: Le Thème de l'Autel.
Doctrine: L'apparence de l'Autel doit refléter la pureté et la clarté
de la doctrine. Ce thème de base établit une esthétique sobre et fonctionnelle,
privilégiant la lisibilité à l'ornementation superflue.
*/

QMainWindow, QWidget {
    background-color: #2c3e50; /* Bleu nuit, pour l'introspection */
    color: #ecf0f1; /* Blanc nuage, pour la clarté */
    font-family: "Segoe UI", "Cantarell", "Verdana", sans-serif;
    font-size: 14pt;
}

QLabel {
    padding: 5px;
}

QPushButton {
    background-color: #3498db; /* Bleu résilience */
    border: none;
    padding: 10px;
    border-radius: 5px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #c0392b; /* Rouge sympathique, pour l'action */
}